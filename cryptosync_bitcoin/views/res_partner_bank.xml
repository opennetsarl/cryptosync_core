<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_bank_form_inherit_crypto_bitcoin" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.crypto.bitcoin</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_parent_bitcoin_addresses"
                        type="object"
                        string="Parent HD Wallet"
                        class="oe_stat_button"
                        icon="fa-bitcoin"
                        invisible="crypto_provider != 'bitcoin' or not bt_hd_wallet_id"
                        groups="cryptosync.group_crypto"/>
                <button name="action_open_child_bitcoin_addresses"
                        type="object"
                        string="Child Addresses"
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="crypto_provider != 'bitcoin' or bt_address_format not in ('xpub', 'ypub', 'zpub', 'vpub')"
                        groups="cryptosync.group_crypto"/>
                <button name="action_generate_bitcoin_addresses"
                        type="object"
                        string="Generate more Child Addresses"
                        class="oe_stat_button"
                        icon="fa-refresh"
                        invisible="crypto_provider != 'bitcoin' or bt_address_format not in ('xpub', 'ypub', 'zpub', 'vpub')"
                        groups="cryptosync.group_crypto"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Bitcoin" name="bitcoin" invisible="crypto_provider != 'bitcoin' or crypto_no_api" groups="cryptosync.group_crypto">
                    <group>
                        <field name="bt_derivation_path"/>
                    </group>
                    <group>
                        <field name="bt_address_format"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
