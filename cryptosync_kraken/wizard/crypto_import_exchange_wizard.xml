<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crypto_import_exchange_wizard_view_form_inherit_kraken" model="ir.ui.view">
        <field name="name">crypto.import.exchange.wizard.view.form.inherit.kraken</field>
        <field name="model">crypto.import.exchange.wizard</field>
        <field name="inherit_id" ref="cryptosync.view_crypto_import_exchange_wizard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='no_api']" position="after">
                <field name="kraken_api_key_id" context="{'default_description': 'Kraken API Key'}"
                    invisible="provider != 'kraken' or no_api" required="provider == 'kraken' and not no_api"/>
                <field name="kraken_api_sec_id" context="{'default_description': 'Kraken Private Key'}"
                    invisible="provider != 'kraken' or no_api" required="provider == 'kraken' and not no_api"/>
            </xpath>
        </field>
    </record>

</odoo>
