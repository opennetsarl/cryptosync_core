<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crypto_transaction_form_inherit_ethereum" model="ir.ui.view">
        <field name="name">crypto.transaction.form.inherit.ethereum</field>
        <field name="model">crypto.transaction</field>
        <field name="inherit_id" ref="cryptosync.view_crypto_transaction_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="before">
                <group>
                    <button name="action_add_to_eth_blacklist" type="object" class="btn btn-danger"
                            invisible="not (state == 'error' and ethereum_spamcoin)"
                        >Blacklist <field name="ethereum_spamcoin" class="oe_inline"/></button>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
