<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_inherit_crypto_coingecko" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.crypto.coingecko</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="cryptosync.view_res_config_settings_form_inherit_crypto"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='cryptocurrencies']" position="inside">
                <block title="CoinGecko" id="coingecko">
                    <setting string="CoinGecko API Key">
                        <field name="coingecko_api_key_id" context="{'default_description': 'CoinGecko API Key'}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

</odoo>
