<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_currency_form_inherit_crypto_coingecko" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.crypto.coingecko</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_crypto_currency_manager_wizard"
                        type="object"
                        string="Currency Manager"
                        class="oe_stat_button"
                        icon="fa-gear"
                        widget="statinfo"
                        context="{'crypto_provider': 'coingecko'}"
                        groups="cryptosync.group_crypto"/>
            </xpath>
            <xpath expr="//group[@name='crypto_only']" position="inside">
                <label for="coingecko_api_code"/>
                <div class="o_row">
                    <field name="coingecko_api_code"/>
                    <button name="open_coingecko"
                            type="object"
                            title="Open on CoinGecko"
                            class="btn-sm btn-link mb4" icon="fa-external-link"
                            invisible="not coingecko_api_code"/>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
