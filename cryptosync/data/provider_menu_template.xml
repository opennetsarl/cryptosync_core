<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_crypto_wallet_template" model="ir.actions.act_window">
        <field name="name">Template Wallets</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{"default_crypto_provider_id": template_id}</field>
        <field name="domain">[('crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_transaction_template" model="ir.actions.act_window">
        <field name="name">Template Raw Transactions</field>
        <field name="res_model">crypto.transaction</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"search_default_draft": 1, "search_default_error": 1}</field>
        <field name="domain">[('wallet_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_transaction_line_template" model="ir.actions.act_window">
        <field name="name">Template Processed Transactions</field>
        <field name="res_model">crypto.transaction.line</field>
        <field name="view_mode">tree</field>
        <field name="context">{"search_default_ready": 1}</field>
        <field name="domain">[('wallet_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_move_template" model="ir.actions.act_window">
        <field name="name">Template Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="domain">[('crypto_transaction_id.wallet_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_move_line_template" model="ir.actions.act_window">
        <field name="name">Template Journal Items</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree,pivot,graph,kanban</field>
        <field name="view_id" ref="account.view_move_line_tree"/>
        <field name="domain">[('display_type', 'not in', ('line_section', 'line_note')), ('move_id.crypto_transaction_id.wallet_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_statement_template" model="ir.actions.act_window">
        <field name="name">Template Statements</field>
        <field name="res_model">account.bank.statement</field>
        <field name="view_mode">tree,pivot,graph,form</field>
        <field name="domain">[('journal_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_statement_line_template" model="ir.actions.act_window">
        <field name="name">Template Statement Lines</field>
        <field name="res_model">account.bank.statement.line</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="domain">[('journal_id.crypto_provider', '=', 'template')]</field>
    </record>

    <record id="action_crypto_journal_template" model="ir.actions.act_window">
        <field name="name">Template Journals</field>
        <field name="res_model">account.journal</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'kanban', 'view_id': ref('account.account_journal_dashboard_kanban_view')}),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('cryptosync.view_account_journal_tree_crypto')}),
        ]"/>
        <field name="domain">[('crypto_provider_id.code', '=', 'template')]</field>
    </record>

    <record id="action_crypto_account_rule_template" model="ir.actions.act_window">
        <field name="name">Template Account Rules</field>
        <field name="res_model">crypto.account.rule</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{"default_provider_id": template_id}</field>
        <field name="domain">[('provider_id.code', '=', 'template')]</field>
    </record>

    <menuitem
        name="Template"
        id="menu_crypto_template"
        parent="cryptosync.menu_crypto_main"
        sequence="1000"
        active="0">

        <menuitem
            name="Wallets"
            id="menu_crypto_wallet_template"
            action="action_crypto_wallet_template"
            sequence="10"/>
        <menuitem
            name="Raw Transactions"
            id="menu_crypto_transaction_template"
            action="action_crypto_transaction_template"
            sequence="20"/>
        <menuitem
            name="Processed Transactions"
            id="menu_crypto_transaction_line_template"
            action="action_crypto_transaction_line_template"
            sequence="30"/>
        <menuitem
            name="Journal Entries"
            id="menu_crypto_move_template"
            action="action_crypto_move_template"
            sequence="40"/>
        <menuitem
            name="Journal Items"
            id="menu_crypto_move_line_template"
            action="action_crypto_move_line_template"
            sequence="45"/>
        <menuitem
            name="Statements"
            id="menu_crypto_statement_template"
            action="action_crypto_statement_template"
            sequence="50"/>
        <menuitem
            name="Statement Lines"
            id="menu_crypto_statement_line_template"
            action="action_crypto_statement_line_template"
            sequence="55"/>
        <menuitem
            name="Journals"
            id="menu_crypto_journal_template"
            action="action_crypto_journal_template"
            sequence="100"
            groups="base.group_no_one"/>
        <menuitem
            name="Account Rules"
            id="menu_crypto_account_rule_template"
            action="action_crypto_account_rule_template"
            sequence="120"/>
    </menuitem>

</odoo>
