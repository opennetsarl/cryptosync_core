<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crypto_provider_tree" model="ir.ui.view">
        <field name="name">crypto.provider.tree</field>
        <field name="model">crypto.provider</field>
        <field name="arch" type="xml">
            <tree editable="bottom" create="0">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <field name="prefix"/>
                <field name="output_type" widget="radio" optional="hide"/>
                <field name="provide_tx" optional="hide"/>
                <field name="provide_rate" optional="hide"/>
                <field name="csv_only" optional="hide"/>
            </tree>
        </field>
    </record>

    <record id="action_crypto_provider" model="ir.actions.act_window">
        <field name="name">Provider</field>
        <field name="res_model">crypto.provider</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_crypto_provider_refresh_all_menus" model="ir.actions.server">
        <field name="name">Refresh All Menus</field>
        <field name="model_id" ref="cryptosync.model_crypto_provider"/>
        <field name="binding_model_id" ref="cryptosync.model_crypto_provider"/>
        <field name="state">code</field>
        <field name="code">records.refresh_all_menus()</field>
    </record>

</odoo>
