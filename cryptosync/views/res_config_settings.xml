<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_config_settings_form_inherit_crypto" model="ir.ui.view">
        <field name="name">res.config.settings.form.inherit.crypto</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cryptocurrencies" string="Cryptocurrencies" name="cryptocurrencies"
                    logo="/cryptosync/static/description/icon.png" groups="cryptosync.group_crypto">
                    <block title="Modules Core AGPL" id="cryptosync_core_modules">
                        <setting help="Get rates from CoinGecko.com">
                            <field name="module_cryptosync_coingecko" string="CoinGecko" />
                        </setting>
                        <setting help="Get Bitcoin transactions">
                            <field name="module_cryptosync_bitcoin" string="Bitcoin"/>
                        </setting>
                        <setting help="Get Ethereum transactions from Etherscan.io">
                            <field name="module_cryptosync_ethereum" string="Ethereum"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_cosmos" string="Cosmos (WIP)"/>
                        </setting>
                        <setting help="Get transactions from Kraken (API)">
                            <field name="module_cryptosync_kraken" string="Kraken"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_okx" string="OKX (WIP)"/>
                        </setting>
                    </block>
                    <block title="Modules Premium OPL" id="cryptosync_premium_modules"
                            help="The following modules required an active CryptoSync Premium license.">
                        <setting help="Get transactions from Binance (CSV)">
                            <field name="module_cryptosync_binance" string="Binance"/>
                        </setting>
                        <setting help="Get transactions from Swissquote (CSV)">
                            <field name="module_cryptosync_swissquote" string="Swissquote"/>
                        </setting>
                        <setting help="Get Tron transactions from TronGrid.io">
                            <field name="module_cryptosync_tron" string="Tron"/>
                        </setting>
                    </block>
                    <block title="Modules On-demand" id="cryptosync_ondemand_modules"
                            help="The following modules are not available yet, but can be developed on demand. Please contact us for more informations.">
                        <setting>
                            <field name="module_cryptosync_alephium" string="Alephium"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_bybit" string="ByBit"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_coinbase" string="Coinbase"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_gateio" string="Gate.io"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_icp" string="ICP"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_kucoin" string="Kucoin"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_mexc" string="MEXC"/>
                        </setting>
                        <setting>
                            <field name="module_cryptosync_solana" string="Solana"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_res_config_settings_crypto" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'cryptocurrencies', 'bin_size': False}</field>
    </record>

</odoo>
