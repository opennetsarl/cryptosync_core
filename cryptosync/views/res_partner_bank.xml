<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_bank_form_inherit_crypto" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.crypto</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/widget[@name='web_ribbon']" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="open_on_explorer"
                            type="object"
                            string="Open on Explorer"
                            class="oe_stat_button"
                            icon="fa-link"
                            attrs="{'invisible': [('explorer_link', '=', False)]}"/>
                </div>
            </xpath>
            <xpath expr="//field[@name='bank_id']" position="after">
                <field name="crypto_provider_id" groups="cryptosync.group_crypto"/>
            </xpath>
            <xpath expr="//field[@name='bank_id']" position="attributes">
                <attribute name="invisible">crypto_provider</attribute>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="after">
                <field name="crypto_currency_ids" widget="many2many_tags" groups="cryptosync.group_crypto"
                       invisible="not crypto_provider" required="crypto_provider"/>
                <field name="crypto_default_move_journal_id" groups="cryptosync.group_crypto"
                       invisible="crypto_output_type != 'move'" required="crypto_output_type == 'move'"/>
            </xpath>
            <xpath expr="//field[@name='currency_id']" position="attributes">
                <attribute name="invisible">crypto_provider</attribute>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group invisible="not crypto_provider" groups="cryptosync.group_crypto">
                    <field name="crypto_no_api" invisible="not crypto_provider"/>
                    <div class="alert alert-warning" role="alert" invisible="not crypto_no_api">
                        <p>If API connection is disable, only CSV imports will be available!</p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_bank_kanban_crypto" model="ir.ui.view">
        <field name="name">res.partner.bank.kanban.crypto</field>
        <field name="model">res.partner.bank</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="crypto_output_type"/>
                <field name="crypto_transaction_count"/>
                <field name="crypto_transaction_line_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="width: 450px;">
                            <div class="d-flex justify-content-between">
                                <div class="d-flex gap-1">
                                    <field name="crypto_provider_image" widget="image" class="o_image_24_cover bg-transparent" attrs="{'invisible': [('crypto_provider_image', '=', False)]}"/>
                                    <h3 class="w-auto"><field name="acc_number"/></h3>
                                </div>
                                <button name="open_on_explorer" type="object" string="Open on Explorer"
                                        class="btn btn-link" icon="fa-link" attrs="{'invisible': [('explorer_link', '=', False)]}"/>
                            </div>
                            <div class="d-flex gap-1" groups="cryptosync.group_crypto">
                                <button name="action_open_crypto_import_transactions_wizard" type="object" class="btn btn-primary"/><i class="fa fa-download"/> Import</button>
                                <button name="action_open_crypto_transactions" type="object" t-attf-class="btn {{record.crypto_transaction_count.raw_value ? 'btn-primary' : 'btn-secondary'}}"><field name="crypto_transaction_count"/> Transactions to Process</button>
                            </div>
                            <div class="d-flex gap-1" groups="cryptosync.group_crypto">
                                <button name="action_open_crypto_transaction_lines" type="object" t-attf-class="btn {{record.crypto_transaction_line_count.raw_value ? 'btn-primary' : 'btn-secondary'}}"><field name="crypto_transaction_line_count"/> Transactions waiting for <field name="crypto_output_type"/></button>
                                <button name="action_open_crypto_generate_statements_wizard" type="object" attrs="{'invisible': [('crypto_transaction_line_count', '=', 0)]}"><field name="crypto_transaction_line_count"/>Generate <field name="crypto_output_type"/></button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_crypto_wallet" model="ir.actions.act_window">
        <field name="name">Wallets and Accounts</field>
        <field name="res_model">res.partner.bank</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="domain">[('crypto_provider', '!=', False)]</field>
    </record>

</odoo>
