<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_partner_bank_form_inherit_crypto" model="ir.ui.view">
        <field name="name">res.partner.bank.form.inherit.crypto</field>
        <field name="model">res.partner.bank</field>
        <field name="inherit_id" ref="base.view_partner_bank_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group groups="cryptosync.group_crypto">
                    <group>
                        <field name="crypto_provider_id"/>
                        <field name="crypto_provider" invisible="1"/>
                    </group>
                </group>
            </xpath>
            <xpath expr="//sheet/widget[@name='web_ribbon']" position="before">
                <div class="oe_button_box" name="button_box">
                    <field name="explorer_link" invisible="1"/>
                    <button name="open_on_explorer"
                            type="object"
                            string="Open on explorer"
                            class="oe_stat_button"
                            icon="fa-link"
                            attrs="{'invisible': [('explorer_link', '=', False)]}"/>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_res_partner_bank_kanban_crypto" model="ir.ui.view">
        <field name="name">res.partner.bank.kanban.crypto</field>
        <field name="model">res.partner.bank</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="crypto_output_type"/>
                <field name="crypto_transaction_line_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_global_click" style="width: 450px;">
                            <div class="d-flex justify-content-between">
                                <div class="d-flex gap-1">
                                    <field name="crypto_provider_image" widget="image" class="o_image_24_cover bg-transparent" attrs="{'invisible': [('crypto_provider_image', '=', False)]}"/>
                                    <h3 class="w-auto"><field name="acc_number"/></h3>
                                </div>
                                <button name="action_open_crypto_update_exchange_wizard" type="object" class="btn btn-link" groups="cryptosync.group_crypto"><i class="fa fa-gear"/> Settings</button>
                            </div>
                            <div class="d-flex gap-1" groups="cryptosync.group_crypto">
                                <button name="action_open_crypto_transactions" type="object" class="btn btn-primary">View Transactions</button>
                                <button name="action_open_crypto_import_transactions_wizard" type="object" class="btn btn-secondary"><i class="fa fa-download"/> Import</button>
                                <button attrs="{'invisible': ['|', ('crypto_output_type', '!=', 'statement'), ('crypto_transaction_line_count', '=', 0)]}"
                                        name="action_open_crypto_generate_statements_wizard" type="object" class="btn btn-secondary"
                                    ><field name="crypto_transaction_line_count"/> transactions waiting for statement</button>
                                <button attrs="{'invisible': ['|', ('crypto_output_type', '!=', 'move'), ('crypto_transaction_line_count', '=', 0)]}"
                                        name="action_open_crypto_generate_statements_wizard" type="object" class="btn btn-secondary"
                                    ><field name="crypto_transaction_line_count"/> transactions waiting for move</button>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

</odoo>
