<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crypto_transaction_line_tree" model="ir.ui.view">
        <field name="name">crypto.transaction.line.tree</field>
        <field name="model">crypto.transaction.line</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="date"/>
                <field name="wallet_id"/>
                <field name="address" optional="show"/>
                <field name="value"/>
                <field name="value_str" optional="hide"/>
                <field name="currency_id" optional="hide"/>
                <field name="description" optional="hide"/>
                <field name="journal_id" optional="hide"/>
                <field name="state" optional="hide"/>
                <button title="Open Transaction" name="action_open_parent" type="object" class="btn-sm btn-link mb4" icon="fa-arrow-right"/>
            </list>
        </field>
    </record>

    <record id="view_crypto_transaction_line_search" model="ir.ui.view">
        <field name="name">crypto.transaction.line.search</field>
        <field name="model">crypto.transaction.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="date"/>
                <field name="description"/>
                <field name="wallet_id"/>
                <field name="address"/>
                <field name="value"/>
                <field name="currency_id"/>
                <filter string="Ready" name="ready" domain="[('state', '=', 'ready')]"/>
                <filter string="Done" name="done" domain="[('state', '=', 'done')]"/>
                <filter string="Ignored" name="ignored" domain="[('state', '=', 'ignored')]"/>
                <separator/>
                <filter string="Date" name="date" date="date"/>
                <filter name="group_by_state" string="State" context="{'group_by': 'state'}"/>
                <filter name="group_by_wallet" string="Wallet" context="{'group_by': 'wallet_id'}"/>
                <filter name="group_by_currency" string="Currency" context="{'group_by': 'currency_id'}"/>
                <filter name="group_by_date" string="Date" context="{'group_by': 'date'}"/>
            </search>
        </field>
    </record>

    <record id="action_crypto_transaction_line" model="ir.actions.act_window">
        <field name="name">Processed Transactions</field>
        <field name="res_model">crypto.transaction.line</field>
        <field name="view_mode">list</field>
        <field name="context">{"search_default_ready": 1}</field>
    </record>

</odoo>
