<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_crypto" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.crypto</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='bank_statements_source']" position="after">
                <field name="crypto_provider_id" widget="radio" groups="cryptosync.group_crypto"
                    attrs="{'invisible': [('bank_statements_source', '!=', 'crypto')], 'required': [('bank_statements_source', '=', 'crypto')]}"/>
            </xpath>
        </field>
    </record>

