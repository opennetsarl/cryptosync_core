<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_journal_form_inherit_crypto" model="ir.ui.view">
        <field name="name">account.journal.form.inherit.crypto</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='bank_account_number']" position="inside">
                <field name="crypto_provider_id" widget="radio" groups="cryptosync.group_crypto"
                    invisible="bank_statements_source != 'crypto'" required="bank_statements_source == 'crypto'"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_journal_tree_crypto" model="ir.ui.view">
        <field name="name">account.journal.tree.crypto</field>
        <field name="model">account.journal</field>
        <field name="arch" type="xml">
            <list editable="bottom" create="0">
                <field name="name"/>
                <field name="crypto_provider_id"/>
                <field name="bank_account_id"/>
                <field name="currency_id"/>
                <field name="code" optional="show"/>
                <field name="default_account_id" optional="show"/>
                <field name="suspense_account_id" optional="hide"/>
                <field name="profit_account_id" optional="hide"/>
                <field name="loss_account_id" optional="hide"/>
            </list>
        </field>
    </record>

</odoo>
