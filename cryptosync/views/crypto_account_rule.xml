<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crypto_account_rule_form" model="ir.ui.view">
        <field name="name">crypto.account.rule.form</field>
        <field name="model">crypto.account.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="domain" widget="domain" options="{'model': 'crypto.transaction.line'}"/>
                        </group>
                        <group>
                            <field name="provider_id"/>
                            <field name="account_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_crypto_account_rule_tree" model="ir.ui.view">
        <field name="name">crypto.account.rule.tree</field>
        <field name="model">crypto.account.rule</field>
        <field name="arch" type="xml">
            <tree>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="provider_id"/>
                <field name="domain" widget="domain" options="{'model': 'crypto.transaction.line'}"/>
                <field name="account_id"/>
            </tree>
        </field>
    </record>

    <record id="action_crypto_account_rule" model="ir.actions.act_window">
        <field name="name">Account Rules</field>
        <field name="res_model">crypto.account.rule</field>
        <field name="view_mode">tree,form</field>
    </record>

</odoo>
