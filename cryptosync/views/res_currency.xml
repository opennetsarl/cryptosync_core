<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_res_currency_form_inherit_crypto" model="ir.ui.view">
        <field name="name">res.currency.form.inherit.crypto</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/*" position="before">
                <div class="oe_button_box" name="button_box">
                    <button name="action_crypto_currency_rate_wizard"
                            type="object"
                            string="Get Rates"
                            class="oe_stat_button"
                            icon="fa-arrow-circle-o-down"
                            widget="statinfo"
                            groups="cryptosync.group_crypto"
                            attrs="{'invisible': [('crypto_rate_provider_id', '=', False)]}"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="before">
                <group string="Cryptocurrency Settings" groups="cryptosync.group_crypto">
                    <group colspan="2">
                        <field name="is_crypto"/>
                    </group>
                    <group name="crypto_fiat">
                        <!-- Inherit this element to add all new fields related to fiat AND crypto -->
                        <field name="crypto_rate_provider_id"/>
                    </group>
                    <group name="crypto_only" attrs="{'invisible': [('is_crypto', '=', False)]}">
                        <!-- Inherit this element to add all new fields related to cryptocurrencies only -->
                        <label for="crypto_unit"/>
                        <div>
                            <field name="crypto_unit" class="oe_inline"/>
                            <field name="name" readonly="1" class="oe_inline"/>
                        </div>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_res_currency_search_inherit_crypto" model="ir.ui.view">
        <field name="name">res.currency.search.inherit.crypto</field>
        <field name="model">res.currency</field>
        <field name="inherit_id" ref="base.view_currency_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <filter name="group_by_is_crypto" string="Crypto/FIAT" context="{'group_by': 'is_crypto'}"/>
            </xpath>
        </field>
    </record>

</odoo>
