<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_crypto_currency_rate_wizard_form" model="ir.ui.view">
        <field name="name">crypto.currency.rate.wizard</field>
        <field name="model">crypto.currency.rate.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="currency_id"/>
                    </group>
                    <group>
                        <field name="rate_date"/>
                    </group>
                </group>
                <footer>
                    <button name="get_crypto_currency_rate" type="object" string="Get Rate" class="oe_highlight"/>
                    <button string="Cancel" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_crypto_currency_rate_wizard" model="ir.actions.act_window">
        <field name="name">Get Rates</field>
        <field name="res_model">crypto.currency.rate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
